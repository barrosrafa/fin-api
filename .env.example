ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Neon PostgreSQL 18 with asyncpg)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_pwONKPD13RiC@ep-ancient-art-b5mstl4r-pooler.c-7.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache & Message Broker (Redis 7+)
REDIS_URL=redis://localhost:6379/0

# Authentication (Supabase Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-hs256-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Billing (Asaas v3)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-token

# Scraper & Collector Settings
SCRAPER_USER_AGENT_ROTATION=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=600
ARQ_MAX_JOBS=20
