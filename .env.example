ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (Neon PostgreSQL 18 with asyncpg)
DATABASE_URL=postgresql+asyncpg://fin_api_rw:CHANGE_ME@localhost:5432/fin
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache & Message Broker (Redis 7+)
REDIS_URL=redis://localhost:6379/0

# Authentication (Supabase Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-hs256-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Billing (Asaas v3)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-token

# Scraper & Collector Settings
SCRAPER_USER_AGENT_ROTATION=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=600
ARQ_MAX_JOBS=20

# Application rate limiting; shared Redis with bounded local fallback on outages.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=200

# JSON arrays; previews must be explicitly listed in their own environment.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_PROXY_CIDRS=[]
BILLING_ENABLED=false

# Directus server-to-server access, never NEXT_PUBLIC.
DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_API_TOKEN=
CMS_WEBHOOK_SECRET=
